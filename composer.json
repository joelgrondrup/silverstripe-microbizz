{
  "name": "joelgrondrup/silverstripe-microbizz",
  "description": "Adds support for event handling for Microbizz in a SilverStripe environment",
  "type": "silverstripe-vendormodule",
  "homepage": "https://github.com/joelgrondrup/silverstripe-microbizz",
  "keywords": [
    "silverstripe",
    "microbizz",
    "ventu"
  ],
  "license": "BSD-3-Clause",
  "authors": [
    {
      "name": "Joel Grøndrup",
      "email": "joel@joel.biz"
    }
  ],
  "support": {
    "issues": "https://github.com/joelgrondrup/silverstripe-microbizz"
  },
  "require": {
    "php": "^8.3",
    "silverstripe/cms": "^6.0",
    "silverstripe/framework": "^6.0",
    "guzzlehttp/guzzle": "^7.8",
    "lekoala/silverstripe-cms-actions": "^2.0",
    "unclecheese/display-logic": "^4.0",
    "colymba/gridfield-bulk-editing-tools": "^5.2"
  },
  "autoload": {
    "psr-4": {
      "JoelGrondrup\\Microbizz\\": "src/"
    }
  },
  "extra": {
    "installer-name": "silverstripe-microbizz",
    "expose": [
      "client"
    ],
    "screenshots": []
  }
}
